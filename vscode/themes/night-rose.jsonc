// Dark Modern · 夜蔷薇。将主题、字体和三个 [Dark Modern] 块合并到 settings.json。
// 字体沿用旧版；壁纸透明度见 ../background/night-rose-fullscreen.jsonc。
{
  "workbench.colorTheme": "Dark Modern",
  "editor.fontFamily": "'Cascadia Code NF', monospace",
  "editor.fontSize": 15,
  "editor.lineHeight": 27,
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      // 基础：黑曜石、墨紫灰、柔白
      "foreground": "#E6E0EB",
      "disabledForeground": "#817B8C",
      "descriptionForeground": "#A7A0B2",
      "icon.foreground": "#C4BDCE",
      "focusBorder": "#A98BEF",
      "selection.background": "#6C4DB899",
      "sash.hoverBorder": "#A98BEF",
      "widget.border": "#302B3B",
      "widget.shadow": "#00000088",
      "textLink.foreground": "#BCA7F7",
      "textLink.activeForeground": "#D6C7FF",
      "textCodeBlock.background": "#1B1725",
      "textBlockQuote.background": "#17131F",
      "textBlockQuote.border": "#7357A4",
      "textSeparator.foreground": "#393242",

      // 标题栏、活动栏、侧栏与底栏
      "titleBar.activeBackground": "#03030A",
      "titleBar.activeForeground": "#DAD4E1",
      "titleBar.inactiveBackground": "#03030A",
      "titleBar.inactiveForeground": "#8A8494",
      "titleBar.border": "#292533",
      "activityBar.background": "#010107",
      "activityBar.foreground": "#E5DCEF",
      "activityBar.inactiveForeground": "#8C8599",
      "activityBar.border": "#292533",
      "activityBar.activeBackground": "#2B203C88",
      "activityBar.activeBorder": "#A98BEF",
      "activityBar.activeFocusBorder": "#C3ADF7",
      "activityBarBadge.background": "#7150B9",
      "activityBarBadge.foreground": "#FFFFFF",
      "modernActivityBarItem.activeBackground": "#A98BEF22",
      "modernActivityBarItem.hoverBackground": "#A98BEF11",
      "sideBar.background": "#04030B",
      "sideBar.foreground": "#DDD6E5",
      "sideBar.border": "#292533",
      "sideBarTitle.foreground": "#E6E0EB",
      "sideBarSectionHeader.background": "#090712",
      "sideBarSectionHeader.foreground": "#CCC4D5",
      "sideBarSectionHeader.border": "#292533",
      "statusBar.background": "#03030A",
      "statusBar.foreground": "#C8C1D0",
      "statusBar.border": "#292533",
      "statusBar.inactiveBackground": "#020208",
      "statusBar.noFolderBackground": "#03030A",
      "statusBar.debuggingBackground": "#6749AB",
      "statusBar.debuggingForeground": "#FFFFFF",
      "statusBar.focusBorder": "#A98BEF",
      "statusBarItem.focusBorder": "#A98BEF",
      "statusBarItem.hoverBackground": "#A98BEF26",
      "statusBarItem.hoverForeground": "#FFFFFF",
      "statusBarItem.prominentBackground": "#382749",
      "statusBarItem.remoteBackground": "#6749AB",
      "statusBarItem.remoteForeground": "#FFFFFF",
      "commandCenter.background": "#0B0913",
      "commandCenter.foreground": "#E6E0EB",
      "commandCenter.border": "#3B3449",
      "commandCenter.activeBorder": "#A98BEF",

      // 编辑器与标签：轻量层级，不让框架盖过壁纸
      "editor.background": "#000000",
      "editor.foreground": "#E6E0EB",
      "editorGroup.border": "#292533",
      "editorGroupHeader.tabsBackground": "#05040D",
      "editorGroupHeader.tabsBorder": "#292533",
      "editorGroupHeader.border": "#292533",
      "tab.activeBackground": "#0A0813",
      "tab.activeForeground": "#F0EAF4",
      "tab.inactiveBackground": "#05040D",
      "tab.inactiveForeground": "#9E96AB",
      "tab.hoverBackground": "#171020",
      "tab.unfocusedActiveBackground": "#080711",
      "tab.unfocusedHoverBackground": "#100C18",
      "tab.border": "#292533",
      "tab.activeBorderTop": "#A98BEF",
      "tab.selectedBorderTop": "#A98BEF",
      "tab.activeModifiedBorder": "#B89AD9",
      "tab.unfocusedActiveBorder": "#292533",
      "tab.unfocusedActiveBorderTop": "#625574",
      "tab.unfocusedActiveModifiedBorder": "#8D799D",
      "breadcrumb.background": "#000000",
      "breadcrumb.foreground": "#9D96AA",
      "breadcrumb.activeSelectionForeground": "#E7DAF5",
      "editorCursor.foreground": "#C7B2FF",
      "editorLineNumber.foreground": "#8E879A",
      "editorLineNumber.activeForeground": "#D4C7E9",
      "editor.selectionBackground": "#64458D88",
      "editor.inactiveSelectionBackground": "#49355977",
      "editor.selectionHighlightBackground": "#A98BEF30",
      "editor.wordHighlightBackground": "#AA8BEF24",
      "editor.wordHighlightStrongBackground": "#AA8BEF3D",
      "editor.lineHighlightBackground": "#B49ACA0B",
      "editor.lineHighlightBorder": "#00000000",
      "editorIndentGuide.background1": "#393342",
      "editorIndentGuide.activeBackground1": "#776582",
      "editorBracketMatch.background": "#A98BEF2B",
      "editorBracketMatch.border": "#A98BEF",
      "editorOverviewRuler.selectionHighlightForeground": "#A98BEF99",
      "minimap.selectionHighlight": "#A98BEF88",

      // 搜索保留琥珀色，避免紫色选区与搜索命中混淆
      "editor.findMatchBackground": "#BA8138A8",
      "editor.findMatchBorder": "#F0BB6D",
      "editor.findMatchHighlightBackground": "#C7904B55",
      "editor.wordHighlightTextBackground": "#AA8BEF24",
      "peekViewEditor.matchHighlightBackground": "#C7904B66",
      "peekViewResult.matchHighlightBackground": "#C7904B66",

      // 列表、扩展、补全、命令面板与菜单
      "list.activeSelectionBackground": "#3A2B58",
      "list.activeSelectionForeground": "#F5EFFB",
      "list.inactiveSelectionBackground": "#2C2340",
      "list.inactiveSelectionForeground": "#E4DAED",
      "list.focusBackground": "#3A2B58",
      "list.focusForeground": "#F5EFFB",
      "list.hoverBackground": "#251D32",
      "list.hoverForeground": "#EEE7F4",
      "list.highlightForeground": "#C7ADF7",
      "list.focusOutline": "#A98BEF",
      "list.dropBackground": "#6749AB77",
      "quickInput.background": "#191522",
      "quickInput.foreground": "#E6E0EB",
      "quickInputTitle.background": "#211B2C",
      "quickInputList.focusBackground": "#3A2B58",
      "quickInputList.focusForeground": "#F5EFFB",
      "quickInputList.focusIconForeground": "#D5C4FA",
      "pickerGroup.border": "#4B3A61",
      "pickerGroup.foreground": "#BEA6E9",
      "editorSuggestWidget.background": "#191522",
      "editorSuggestWidget.border": "#3A3246",
      "editorSuggestWidget.foreground": "#E6E0EB",
      "editorSuggestWidget.selectedBackground": "#3A2B58",
      "editorSuggestWidget.selectedForeground": "#F5EFFB",
      "editorWidget.background": "#191522",
      "editorWidget.foreground": "#E6E0EB",
      "editorWidget.border": "#3A3246",
      "peekViewEditor.background": "#090712",
      "peekViewResult.background": "#100C18",
      "peekViewResult.selectionBackground": "#3A2B58",
      "peekViewResult.selectionForeground": "#F5EFFB",
      "menu.background": "#17131F",
      "menu.foreground": "#E6E0EB",
      "menu.border": "#3A3246",
      "menu.selectionBackground": "#3A2B58",
      "menu.selectionForeground": "#FFFFFF",
      "menu.separatorBackground": "#3A3246",
      "menubar.selectionBackground": "#3A2B58",
      "menubar.selectionForeground": "#FFFFFF",
      "toolbar.hoverBackground": "#A98BEF20",
      "actionBar.toggledBackground": "#3A2B58",

      // 输入与按钮
      "input.background": "#1C1727",
      "input.foreground": "#F0EAF4",
      "input.border": "#40364D",
      "input.placeholderForeground": "#958BA3",
      "inputOption.activeBackground": "#A98BEF44",
      "inputOption.activeBorder": "#A98BEF",
      "dropdown.background": "#1C1727",
      "dropdown.foreground": "#F0EAF4",
      "dropdown.border": "#40364D",
      "dropdown.listBackground": "#17131F",
      "checkbox.background": "#1C1727",
      "checkbox.border": "#5B4D6B",
      "button.background": "#7352C1",
      "button.foreground": "#FFFFFF",
      "button.hoverBackground": "#8060CE",
      "button.secondaryBackground": "#2A2038",
      "button.secondaryForeground": "#E5DCEF",
      "button.secondaryHoverBackground": "#372946",
      "progressBar.background": "#A98BEF",

      // 面板、通知、设置与欢迎页
      "panel.background": "#04030B",
      "panel.border": "#292533",
      "panelTitle.activeBorder": "#A98BEF",
      "panelTitle.activeForeground": "#EDE5F3",
      "panelTitle.inactiveForeground": "#958DA3",
      "panelInput.border": "#40364D",
      "notifications.background": "#1B1725",
      "notifications.foreground": "#E6E0EB",
      "notifications.border": "#40364D",
      "notificationCenterHeader.background": "#211B2C",
      "notificationCenterHeader.foreground": "#E6E0EB",
      "notificationLink.foreground": "#C7ADF7",
      "notificationsInfoIcon.foreground": "#A98BEF",
      "notificationsWarningIcon.foreground": "#E7B568",
      "notificationsErrorIcon.foreground": "#F07C83",
      "settings.headerForeground": "#EEE6F4",
      "settings.modifiedItemIndicator": "#A98BEF",
      "settings.dropdownBackground": "#1C1727",
      "settings.dropdownBorder": "#40364D",
      "welcomePage.background": "#000000",
      "welcomePage.tileBackground": "#100C18",
      "welcomePage.progress.foreground": "#A98BEF",
      "extensionButton.prominentBackground": "#7352C1",
      "extensionButton.prominentForeground": "#FFFFFF",
      "extensionButton.prominentHoverBackground": "#8060CE",
      "extensionButton.background": "#2A2038",
      "extensionButton.foreground": "#E5DCEF",
      "extensionButton.hoverBackground": "#372946",
      "extensionIcon.verifiedForeground": "#BCA7F7",
      "extensionIcon.starForeground": "#E7B568",

      // 源码管理、诊断、差异：语义色与主题紫色分工
      "errorForeground": "#F07C83",
      "list.errorForeground": "#F07C83",
      "list.warningForeground": "#E7B568",
      "editorError.foreground": "#F07C83",
      "editorWarning.foreground": "#E7B568",
      "editorInfo.foreground": "#A98BEF",
      "gitDecoration.modifiedResourceForeground": "#B89AD9",
      "gitDecoration.untrackedResourceForeground": "#C8A3B9",
      "gitDecoration.addedResourceForeground": "#8AC7A3",
      "gitDecoration.deletedResourceForeground": "#F07C83",
      "gitDecoration.conflictingResourceForeground": "#E7B568",
      "gitDecoration.ignoredResourceForeground": "#827B8D",
      "editorGutter.modifiedBackground": "#B89AD9",
      "editorGutter.addedBackground": "#8AC7A3",
      "editorGutter.deletedBackground": "#F07C83",
      "diffEditor.insertedLineBackground": "#548C7440",
      "diffEditor.removedLineBackground": "#AE5A6640",
      "diffEditor.insertedTextBackground": "#548C7466",
      "diffEditor.removedTextBackground": "#AE5A6666",
      "merge.currentHeaderBackground": "#654D8E66",
      "merge.incomingHeaderBackground": "#548C7466",

      // 终端：界面紫色；ANSI 保留红绿黄及壁纸的青色
      "terminal.background": "#000000",
      "terminal.foreground": "#E1DBE9",
      "terminalCursor.foreground": "#C7B2FF",
      "terminal.selectionBackground": "#64458D88",
      "terminal.inactiveSelectionBackground": "#49355977",
      "terminal.tab.activeBorder": "#A98BEF",
      "terminal.ansiBlack": "#20202A",
      "terminal.ansiRed": "#D77382",
      "terminal.ansiGreen": "#86BFA0",
      "terminal.ansiYellow": "#DDB777",
      "terminal.ansiBlue": "#8C91D2",
      "terminal.ansiMagenta": "#B78BCF",
      "terminal.ansiCyan": "#84BDC2",
      "terminal.ansiWhite": "#DDD6E5",
      "terminal.ansiBrightBlack": "#787282",
      "terminal.ansiBrightRed": "#F49BA3",
      "terminal.ansiBrightGreen": "#A8D9BA",
      "terminal.ansiBrightYellow": "#F2D19A",
      "terminal.ansiBrightBlue": "#B1B6EC",
      "terminal.ansiBrightMagenta": "#D4A9EB",
      "terminal.ansiBrightCyan": "#ACE0DD",
      "terminal.ansiBrightWhite": "#FCF8FF",

      // 内置聊天控件
      "chat.slashCommandBackground": "#7352C144",
      "chat.slashCommandForeground": "#D5C4FA",
      "agentsChatInput.focusBorder": "#A98BEF"
    }
  },
  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        { "scope": "comment", "settings": { "foreground": "#9BB09F", "fontStyle": "italic" } },
        { "scope": "keyword", "settings": { "foreground": "#C7A0E6", "fontStyle": "italic" } },
        { "scope": "keyword.control", "settings": { "foreground": "#D3A5E9", "fontStyle": "italic" } },
        { "scope": "keyword.other", "settings": { "foreground": "#C7A0E6", "fontStyle": "italic" } },
        { "scope": "storage.modifier", "settings": { "foreground": "#C7A0E6" } },
        { "scope": "storage.type", "settings": { "foreground": "#E7B58A" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#E7B58A" } },
        { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#BBA7EF" } },
        { "scope": ["variable", "entity.name.variable", "support.variable"], "settings": { "foreground": "#DDD5E6" } },
        { "scope": ["variable.language", "constant.language"], "settings": { "foreground": "#D0B6EB" } },
        { "scope": "constant.numeric", "settings": { "foreground": "#E0BF8A" } },
        { "scope": "string", "settings": { "foreground": "#A8D1B5" } },
        { "scope": "constant.character.escape", "settings": { "foreground": "#E1BD91" } },
        { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#BCA7E6" } },
        { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#B6ADBF" } },
        { "scope": "markup.heading", "settings": { "foreground": "#C7A0E6", "fontStyle": "bold" } },
        { "scope": "markup.link", "settings": { "foreground": "#BCA7F7" } },
        { "scope": "invalid.illegal.lean4", "settings": { "foreground": "#FF708E" } }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "enabled": true,
      "rules": {
        "keyword": { "foreground": "#C7A0E6", "italic": true },
        "type": "#E7B58A",
        "class": "#E7B58A",
        "interface": "#E7B58A",
        "enum": "#E7B58A",
        "function": "#BBA7EF",
        "method": "#BBA7EF",
        "variable": "#DDD5E6",
        "parameter": "#DDD5E6",
        "property": "#D7C7E5",
        "enumMember": "#D9B5D5"
      }
    }
  }
}
